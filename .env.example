ALCHEMY_API_KEY="<your-alchemy-key>"

# Qwen 3.8 Max (Alibaba Cloud) — for ticket #9's bot demo
QWEN_API_KEY="<your-qwen-api-key>"
QWEN_API_HOST="<your-qwen-api-host>"
QWEN_OPENAI_COMPATIBLE_ENDPOINT="https://<your-qwen-api-host>/compatible-mode/v1"
QWEN_DASHSCOPE_ENDPOINT="https://<your-qwen-api-host>/api/v1"
MONAD_TESTNET_HTTP_RPC_URL="https://monad-testnet.g.alchemy.com/v2/<your-alchemy-key>"
MONAD_MAINNET_HTTP_RPC_URL="https://monad-mainnet.g.alchemy.com/v2/<your-alchemy-key>"
MONAD_TESTNET_WS_RPC_URL="wss://monad-testnet.g.alchemy.com/v2/<your-alchemy-key>"
MONAD_MAINNET_WS_RPC_URL="wss://monad-mainnet.g.alchemy.com/v2/<your-alchemy-key>"

# Public frontend routing. The SPA talks only to this relay family route; it never receives either
# HTTP RPC URL above or the Alchemy key embedded in it. `MONAD_TESTNET_HTTP_RPC_URL` is passed only
# to the backend process by docker-compose.
MONAD_RELAY_BASE_URL="http://localhost:8080"
MONAD_RPC_CHAIN="monad-testnet"

# Literal Monad burn address used for Stamp burns (ticket #7). Decision: the
# canonical dead-address convention, not address(0) — see issue #7 for the
# one-sentence rationale. Both the Rust backend and the TS wallet must read
# this single value rather than hardcoding their own copies.
MONAD_STAMP_BURN_ADDRESS=0x000000000000000000000000000000000000dEaD

# Minimum aggregate amount, in wei, that the stamp payments of one direct message must send to the
# recipient's one-time destinations. `backend/cashweb/run-local-monad.sh` writes this value into
# the generated `[registry.monad_mailbox] min_value_wei`; `cashwebd-exe` itself never reads this
# environment variable. The relay only serves `PUT /message/monad` when that config table is
# enabled. Both checked-in configs (`cashwebd.local.toml`, `backend/docker/cashwebd.toml`) ENABLE it
# by default with this minimum and chain ID; the RPC URL (`MONAD_TESTNET_HTTP_RPC_URL` above) and
# `FRANK_NETWORK_TAG` (below) are REQUIRED in the environment or `cashwebd-exe` refuses to start.
# 1000000000000 wei = 0.000001 MON -- small but nonzero, fine for a demo.
CASHWEB_STAMP_MIN_BURN_VALUE_WEI=1000000000000
# EVM chain ID every signed stamp payment must carry. Written into the launcher-generated
# `[registry.monad_mailbox] expected_chain_id`. Monad testnet is 10143 (mainnet is 143).
MONAD_TESTNET_CHAIN_ID=10143

# Wallet/bot DM default, independent from the relay's low protocol acceptance floor (0.01 MON).
FRANK_DM_DEFAULT_STAMP_VALUE_WEI=10000000000000000

# Ticket #30 (topic burn-weighted votes — a general durable topic-broadcast
# primitive, not a forum-specific feature; see PLAN.md): `PUT /message/monad/topics`
# and `PUT /message/monad/topics/vote` (see
# `backend/cashweb/cashweb-registry/src/http/monad_topics.rs`'s `MonadTopicGateConfig`)
# deliberately reuse `MONAD_TESTNET_HTTP_RPC_URL` and `MONAD_STAMP_BURN_ADDRESS`
# above rather than introducing topic-specific env vars — a topic vote burns to
# the same address, just tagged with a different LOKAD ID in its calldata, so a
# second burn-address var would just be another opportunity for a name mismatch
# (the direct-message route no longer reads any of these; see above). No
# topic-specific minimum-value var exists either: a topic vote's exact burned
# value is its weight, never thresholded against a minimum.

# Ticket #39 (Frank-specific network tag, see PLAN.md constraint 9): a short
# Frank/Stamp-specific code the relay stamps onto every newly-stored
# `StoredMonadMessage`/`StoredMonadTopicPost` (see
# `backend/cashweb/cashweb-registry/src/network_tag.rs`), read once at server
# startup. Deliberately NOT a raw EVM `chainId` — Lotus (and any future non-EVM
# `ChainAdapter`) has no such concept — and deliberately NOT derived from
# whichever `MONAD_TESTNET_HTTP_RPC_URL`/`MONAD_MAINNET_HTTP_RPC_URL` happens to
# be configured, since that would be silently wrong if an operator points the
# RPC URL at a different network without also updating this var. Reserved
# values (4-byte, LOKAD-style): `MONT` = Monad testnet, `MON1` = Monad mainnet,
# `LTUS` reserved for a hypothetical future Lotus adapter (not wired up yet).
# REQUIRED whenever the Monad mailbox is enabled (the shipped default): the relay only admits
# direct messages carrying its own tag, so `cashwebd-exe` refuses to start without it (compose and
# `run-local-monad.sh` default it to MONT). Use MON1 for a mainnet relay.
FRANK_NETWORK_TAG=MONT
