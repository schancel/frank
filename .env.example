# Electrum servers for the relay's Bitcoin-family proxy: tcp://, ssl://, ws:// or wss://, several
# separated by spaces. Unset uses the public testnet servers in backend/cashweb/run-local-monad.sh.
# BTC_TESTNET_ELECTRUM_URL="ssl://electrum.blockstream.info:60002"
# BCH_TESTNET_ELECTRUM_URL="ssl://testnet.imaginary.cash:50002"
SOLANA_DEVNET_HTTP_RPC_URL="https://api.devnet.solana.com"

# Public frontend routing. The SPA talks only to this relay family route; it never receives either
# HTTP RPC URL above or the Alchemy key embedded in it. `MONAD_TESTNET_HTTP_RPC_URL` is passed only
# to the backend process by docker-compose.
MONAD_RELAY_BASE_URL="http://localhost:8080"
MONAD_RPC_CHAIN="monad-testnet"

# Literal Monad burn address used for Stamp burns (ticket #7). Decision: the
# canonical dead-address convention, not address(0) — see issue #7 for the
# one-sentence rationale. Both the Rust backend and the TS wallet must read
# this single value rather than hardcoding their own copies.
MONAD_STAMP_BURN_ADDRESS=0x000000000000000000000000000000000000dEaD

# Minimum aggregate amount, in wei, that the stamp payments of one direct message must send to the
# recipient's one-time destinations. `backend/cashweb/run-local-monad.sh` writes this value into
# the generated `[registry.monad_mailbox] min_value_wei`; `cashwebd-exe` itself never reads this
# environment variable. The relay only serves its message routes when that config table is
# enabled. Both checked-in configs (`cashwebd.local.toml`, `backend/docker/cashwebd.toml`) ENABLE it
# by default with this minimum on `[registry] network`; that network's RPC URL
# (`MONAD_TESTNET_HTTP_RPC_URL` above) is REQUIRED in the environment or `cashwebd-exe` refuses to
# start. 1000000000000 wei = 0.000001 MON -- small but nonzero, fine for a demo.
CASHWEB_STAMP_MIN_BURN_VALUE_WEI=1000000000000
# The relay's network for `backend/cashweb/run-local-monad.sh`: `monad-testnet` (default) or
# `monad-mainnet`. The launcher writes it into `[registry] network`; the relay derives the chain
# id, checkpoint and network tag from docs/protocol/chains/v1.json and reads no tag variable.
# FRANK_RELAY_NETWORK=monad-testnet

# Wallet/bot DM default, independent from the relay's low protocol acceptance floor (0.01 MON).
# Default recipient attention stamp, in AVU; network fees are separate.
FRANK_DM_DEFAULT_STAMP_AVU=0.1

# Forum posts and votes burn to `[registry.forum] burn_address` in the relay config;
# `run-local-monad.sh` writes MONAD_STAMP_BURN_ADDRESS above into it. `cashwebd-exe` reads neither
# variable below: the relay's network tag comes from `[registry] network`.

# Network tag the bots and the CLI stamp messages with (`MONT` = Monad testnet, `MON1` = Monad
# mainnet). It must match the relay's `[registry] network`.
FRANK_NETWORK_TAG=MONT

# ngrok support for yarn demo:
# Set FRANK_DEMO_NGROK=1 to automatically start ngrok tunnels for the app and relay.
# Alternatively, specify existing public URLs:
# FRANK_DEMO_NGROK=1
# FRANK_DEMO_PUBLIC_RELAY_URL="https://<relay-subdomain>.ngrok-free.app"
# FRANK_DEMO_PUBLIC_APP_URL="https://<app-subdomain>.ngrok-free.app"
# NGROK_AUTHTOKEN="<your-ngrok-authtoken>"

# -----------------------------------------------------------------------------
# Clustered Relay & Multi-Node Stack (docker-compose.yml)
# -----------------------------------------------------------------------------
# Apache Kvrocks (1-instance RocksDB backed RESP CAS store)
KVROCKS_PORT=6666
RESP_URL="redis://kvrocks:6666"

# Core NATS Event Bus (Lightweight real-time pubsub)
NATS_PORT=4222
NATS_URL="nats://nats:4222"

# S3 Compatible Object Store (MinIO)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT="http://minio:9000"
S3_BUCKET="frank-gateway-blobs"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Frank Email Gateway (MIME/SMTP ↔ Frank Encrypted DMs)
GATEWAY_DOMAIN="frank.org"
GATEWAY_SMTP_PORT=2525
GATEWAY_HTTP_PORT=8082
BLOB_STORAGE_PROVIDER="s3"
STRIPE_WEBHOOK_SECRET="whsec_demo"
# PAYPAL_CLIENT_ID=""
# PAYPAL_WEBHOOK_ID=""

# -----------------------------------------------------------------------------
# Optional Monitoring Stack (docker compose --profile monitoring up -d)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9095
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"


