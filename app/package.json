{
  "name": "frank",
  "version": "0.0.1",
  "description": "A Monad powered internet cryptomessenger",
  "productName": "Frank",
  "author": "shammah@cryptonumismatics.org",
  "private": true,
  "scripts": {
    "lint": "eslint 'src/**/*.{ts,js,vue}' && prettier --check .",
    "lint:fix": "prettier --write . && eslint 'src/**/*.{ts,js,vue}' --fix",
    "dev": "quasar dev -m electron -- --no-sandbox --disable-setuid-sandbox",
    "dev:browser": "quasar dev -- --no-sandbox --disable-setuid-sandbox",
    "build": "quasar build -m electron -b builder",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "generate:protobuffers": "/bin/sh ./generate_protobufs.sh",
    "clean:protobuffers": "git clean -di && git pull",
    "dev-ios": "quasar dev -m capacitor -T ios",
    "build-ios": "quasar build  -m capacitor -T ios",
    "dev-android": "quasar dev -m capacitor -T android",
    "build-android": "quasar build  -m capacitor -T android",
    "build-android-debug": "quasar build  -m capacitor -T android -d",
    "zipalign-android": "zipalign -v -p 4 ./dist/capacitor/android/apk/release/app-release-unsigned.apk ./dist/capacitor/android/apk/release/app-release-unsigned-aligned.apk",
    "build-android-release": "yarn build-android && yarn zipalign-android && apksigner sign --ks release.keystore.jks --out ./dist/capacitor/android/apk/release/app-release.apk ./dist/capacitor/android/apk/release/app-release-unsigned-aligned.apk",
    "test:unit": "jest --updateSnapshot",
    "test:unit:ci": "jest --ci",
    "test:unit:coverage": "jest --coverage",
    "test:unit:watch": "jest --watch",
    "test:unit:watchAll": "jest --watchAll",
    "serve:test:coverage": "quasar serve test/jest/coverage/lcov-report/ --port 8788",
    "concurrently:dev:jest": "concurrently \"quasar dev\" \"jest --watch\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@capacitor/core": "2.5.0",
    "@electron/remote": "^2.0.8",
    "@frank/cashweb": "*",
    "@frank/nakamoto": "*",
    "@frank/wallet": "*",
    "@quasar/extras": "^1.15.11",
    "axios": "^0.24.0",
    "bip39": "^3.0.2",
    "bitcore-lib-xpi": "*",
    "chronik-client": "^0.8.2",
    "core-js": "^3.24.1",
    "dompurify": "^2.3.1",
    "electron-windows-badge": "^1.1.0",
    "level": "^7.0.0",
    "marked": "^4.0.10",
    "moment": "^2.29.4",
    "node-emoji": "^1.11.0",
    "pinia": "^2.0.12",
    "qrcode.vue": "^3.3.3",
    "quasar": "^2.24.0",
    "ramda": "^0.27.0",
    "vue": "^3.5.43",
    "vue-i18n": "^9.1.9",
    "vue-router": "^5.3.1",
    "webpack": ">=5.76.0",
    "workbox-webpack-plugin": "^6.5.4",
    "worker-loader": "^3.0.8"
  },
  "devDependencies": {
    "sass": "^1.105.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "@rollup/plugin-inject": "^5.0.5",
    "node-stdlib-browser": "^1.3.1",
    "@babel/core": "^7.16.0",
    "@babel/eslint-parser": "^7.16.3",
    "@babel/preset-env": "^7.16.4",
    "@babel/preset-typescript": "^7.16.0",
    "@capacitor/android": "^2.5.0",
    "@quasar/app-vite": "^3.10.0",
    "@types/dompurify": "^2.3.1",
    "@types/jest": "^29",
    "@types/marked": "^4.0.1",
    "@types/node": "^16.11.11",
    "@types/node-emoji": "^1.8.1",
    "@types/ramda": "^0.27.59",
    "@typescript-eslint/eslint-plugin": "^5.33.1",
    "@typescript-eslint/parser": "^5.33.1",
    "@vue/test-utils": "^2.4",
    "@vue/vue3-jest": "^29",
    "autoprefixer": "^10.4.8",
    "babel-jest": "^29",
    "babel-loader": "^8.2.3",
    "copy-webpack-plugin": "^10.0.0",
    "devtron": "^1.4.0",
    "electron": "^20.1.1",
    "electron-builder": "^23.3.3",
    "electron-debug": "^3.2.0",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jest": "^25.3.0",
    "eslint-plugin-node": "^11.0.0",
    "eslint-plugin-prettier-vue": "^4.2.0",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-vue": "^8.1.1",
    "eslint-webpack-plugin": "^3.1.1",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "jest-transform-stub": "^2",
    "node-polyfill-webpack-plugin": "^1.1.4",
    "postcss": "^8.1.0",
    "prettier": "^2.5.1",
    "promise": "^8",
    "ts-jest": "^29",
    "ts-protoc-gen": "^0.15.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "protoc": "^1.0.4"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
