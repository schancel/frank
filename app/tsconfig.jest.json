{
  // ts-jest's own tsconfig: extends the app's real tsconfig.json (whose target/lib come from
  // @quasar/app-webpack's browser-facing preset) but targets a modern-enough ES version for
  // Jest's Node runtime, since Jest runs compiled test code directly in Node, never through
  // webpack/babel's separate down-leveling pipeline the app build uses.
  //
  // Without this, ts-jest inherits the app tsconfig's ES2017 target and rejects BigInt literals
  // (`1n`) with TS2737 - which several already-written wallet tests use freely, since ethers v6
  // is BigInt-based.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2020",
    "isolatedModules": true
  },
  // `exclude` is inherited independently of `include`/`compilerOptions` in TS config extension --
  // without overriding it here, this file would inherit tsconfig.json's `*.jest.test.ts` exclude
  // (added 2026-09-26 to keep test files out of the production webpack build), which is exactly
  // backwards for *this* config: ts-jest itself tolerates the inherited exclude fine (it transpiles
  // whatever file Jest asks for regardless), but typescript-eslint's parser consults `include`/
  // `exclude` to decide whether a file belongs to a project at all -- and this project's whole
  // purpose is covering the test files the other one deliberately excludes.
  "exclude": ["node_modules"]
}
