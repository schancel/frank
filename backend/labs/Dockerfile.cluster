# The cluster lab's relay image (cashwebd-exe with FoundationDB) and its HTTP contract test.
# Keep the FDB server and client versions identical; the FDB image supplies libfdb_c.
FROM foundationdb/foundationdb:7.3.63 AS fdb-client

FROM rust:1-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc-12 g++-12 libclang-dev protobuf-compiler python3 && rm -rf /var/lib/apt/lists/*
COPY --from=fdb-client /usr/lib/libfdb_c.so /usr/local/lib/libfdb_c.so
RUN ldconfig
# Keep local builds within the shared memory budget; larger builders can opt in.
ARG CARGO_BUILD_JOBS=1
ENV CC=gcc-12 CXX=g++-12 CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
WORKDIR /build
COPY backend/bitcoinsuite backend/bitcoinsuite
COPY backend/cashweb backend/cashweb
COPY docs docs
COPY fixtures fixtures
COPY backend/labs/cluster_contract.rs backend/cashweb/cashweb-registry/tests/lab_cluster_contract.rs
# Both lab tests sign their solonet payments with this module (`#[path]` from tests/).
COPY backend/labs/solonet_payer.rs backend/labs/solonet_payer.rs
COPY backend/labs/copy-test-artifact.py /copy-test-artifact.py
WORKDIR /build/backend/cashweb
# Cargo checks source mtimes; force workspace freshness when reusing a target cache
# across isolated checkouts. Native dependencies stay cached.
RUN --mount=type=cache,sharing=locked,id=frank-labs-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,sharing=locked,id=frank-labs-git,target=/usr/local/cargo/git \
    --mount=type=cache,sharing=locked,id=frank-labs-cluster-target,target=/build/backend/cashweb/target \
    find /build/backend /build/docs -type d -name target -prune -o -type f -exec touch {} + && \
    cargo build --locked --release -p cashwebd-exe --features foundationdb && \
    cp target/release/cashwebd-exe /cashwebd-exe && \
    cargo test --locked --release -p cashweb-registry --test lab_cluster_contract --no-run --message-format=json > /tmp/cluster-artifacts.json && \
    python3 /copy-test-artifact.py /tmp/cluster-artifacts.json /cluster-contract create_on_a_append_on_b_read_on_c

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*

FROM runtime AS relay
COPY --from=fdb-client /usr/lib/libfdb_c.so /usr/lib/libfdb_c.so
RUN ldconfig
COPY --from=builder /cashwebd-exe /usr/local/bin/cashwebd-exe
ENTRYPOINT ["cashwebd-exe", "/etc/cashwebd/cashwebd.toml"]

FROM runtime AS contract
COPY --from=builder /cluster-contract /usr/local/bin/cluster-contract
# The fault tests stop and start lab containers, so the tests run one at a time.
ENTRYPOINT ["cluster-contract", "--test-threads=1", "--nocapture"]
