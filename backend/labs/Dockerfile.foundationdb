# Builds the cashweb-registry FoundationDB transaction contract and NATS lab tests, the
# cluster-mode daemon test (the real cashwebd-exe built with `--features foundationdb`), and the
# two-relay registry test (usernames raced across relays, profiles replaced across relays).
# Keep server/client release versions identical. FDB's image supplies native libfdb_c.
FROM foundationdb/foundationdb:7.3.63 AS fdb-client
FROM rust:1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends gcc-12 g++-12 libclang-dev protobuf-compiler python3 && rm -rf /var/lib/apt/lists/*
COPY --from=fdb-client /usr/lib/libfdb_c.so /usr/local/lib/libfdb_c.so
RUN ldconfig
ENV CC=gcc-12 CXX=g++-12 CARGO_BUILD_JOBS=2
WORKDIR /build
COPY backend/bitcoinsuite backend/bitcoinsuite
COPY backend/cashweb backend/cashweb
COPY docs docs
COPY fixtures fixtures
COPY backend/labs/backend_contract.rs backend/cashweb/cashweb-registry/tests/lab_backend_contract.rs
COPY backend/labs/copy-test-artifact.py /copy-test-artifact.py
WORKDIR /build/backend/cashweb
# Cargo checks source mtimes; force workspace freshness when reusing a target cache
# across isolated checkouts. Native dependencies stay cached.
RUN --mount=type=cache,sharing=locked,id=frank-labs-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,sharing=locked,id=frank-labs-git,target=/usr/local/cargo/git \
    --mount=type=cache,sharing=locked,id=frank-labs-fdb-target,target=/build/backend/cashweb/target \
    find /build/backend /build/docs -type d -name target -prune -o -type f -exec touch {} + && \
    cargo test --locked -p cashweb-registry --features foundationdb --test kv_transaction_contract --no-run --message-format=json > /tmp/kv-artifacts.json && \
    python3 /copy-test-artifact.py /tmp/kv-artifacts.json /kv-transaction-contract foundationdb_transaction_contract && \
    find /build/backend /build/docs -type d -name target -prune -o -type f -exec touch {} + && \
    cargo test --locked -p cashweb-registry --features foundationdb --test lab_backend_contract --no-run --message-format=json > /tmp/lab-artifacts.json && \
    python3 /copy-test-artifact.py /tmp/lab-artifacts.json /backend-contract real_nats_notification_and_durable_offline_catch_up && \
    find /build/backend /build/docs -type d -name target -prune -o -type f -exec touch {} + && \
    cargo test --locked -p cashwebd-exe --features foundationdb --test foundationdb_daemon --no-run --message-format=json > /tmp/daemon-artifacts.json && \
    python3 /copy-test-artifact.py /tmp/daemon-artifacts.json /foundationdb-daemon cluster_mode_daemons_share_groups_through_foundationdb && \
    find /build/backend /build/docs -type d -name target -prune -o -type f -exec touch {} + && \
    cargo test --locked -p cashweb-registry --features foundationdb --lib --no-run --message-format=json > /tmp/registry-artifacts.json && \
    python3 /copy-test-artifact.py /tmp/registry-artifacts.json /registry-cluster registry_is_shared_by_two_relays_through_foundationdb && \
    cp target/debug/cashwebd-exe /cashwebd-exe
ENV FRANK_CASHWEBD_EXE=/cashwebd-exe
# The transaction contract starts its two FDB worker processes from its own executable.
ENTRYPOINT ["/bin/sh", "-c", "/kv-transaction-contract --exact live_fdb::foundationdb_transaction_contract --ignored --nocapture && /backend-contract --nocapture && /foundationdb-daemon --ignored --nocapture && /registry-cluster --exact store::registry_fdb_tests::registry_is_shared_by_two_relays_through_foundationdb --ignored --nocapture"]
