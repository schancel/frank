# One configuration for relay-a, relay-b and relay-c of the disposable cluster lab.
# A template: lab-init writes it to the shared `config` volume with @PUBLIC_ORIGIN@ set to the
# proxy origin (http://127.0.0.1:$FRANK_LAB_CLUSTER_PORT), the one origin clients use, and
# @SOLONET_CHECKPOINT_NUMBER@ and @SOLONET_CHECKPOINT_HASH@ set to a block a few behind the head
# of the solonet run it reached (see below). That is the block each relay starts from; a running
# relay then moves its checkpoint forward along the same chain (operator_checkpoint_refresh_secs).
# Synthetic and local-only: no funded identity and no production state.
host = "0.0.0.0:8080"
url = "@PUBLIC_ORIGIN@"

[registry]
db_path = "/data/registry.rocksdb"
# solonet, the local Monad network: every group write pays the hosting relay on it.
network = "monad-regtest"
net = "regtest"
peers = []
public_relay_urls = []
# Written once by lab-init into a shared volume (mode 0400); identical on every replica.
session_secret_file = "/secrets/session-secret"
vapid_private_key_file = "/secrets/vapid-private-key"

# Group ciphertexts over 64 KiB go to the lab's MinIO, shared by every replica. lab-init writes
# the credentials file (mode 0400) from MinIO's generated root credentials.
[registry.large_values]
driver = "s3"
endpoint = "http://minio:9000"
region = "us-east-1"
bucket = "frank-lab-blobs"
prefix = "lab"
credentials_file = "/secrets/s3-credentials"

[registry.cluster]
enabled = true
driver = "foundationdb"
fdb_cluster_file = "/cluster/fdb.cluster"
fdb_subspace_prefix = "frank-cluster-lab/"
cluster_name = "lab"
# Groups, direct messages, large values, the registry database, the directory and the forum are
# shared. Hourly allowances default local unless [registry.hourly_quotas] explicitly selects
# Redis. This lab keeps its preview escape hatch; strict shared deployment must configure Redis.
preview_replica_local_owners = true

[registry.cluster.nats]
enabled = true
url = "nats://nats:4222"

# The open directory, shared by all three replicas through FoundationDB, with evidence over
# 64 KiB in the MinIO above. A synthetic relay id and identity (the reviewed vectors' relay)
# with the proxy origin as the endpoint, which must be the relay's `url`; the cluster contract
# signs entries naming it.
[registry.directory]
relay_id = "000102030405060708090a0b0c0d0e0f"
relay_identity = "02e493dbf1c10d80f3581e4904930b1404cc6c13900ee0758474fa94abe8c4cd13"
endpoint = "@PUBLIC_ORIGIN@"
# 2028-01-01T00:00:00Z
binding_expiry_ns = "1830297600000000000"
# The contract publishes hundreds of accounts from one container; its per-source hourly
# allowance is shared across all three replicas.
enrollments_per_source_per_hour = 100000

# Every new group write carries one signed transaction on solonet paying the payee at least the
# group's price (its creator's, never below min_price_wei) and committing to the proxy origin
# above, which all three replicas share. Whichever replica takes the write checks the payment
# against solonet before accepting it. The lab's payee is the burn address.
[registry.group_writes]
min_price_wei = "1000000000000"
payee = "0x000000000000000000000000000000000000dEaD"

# solonet's upstream. compose passes FRANK_LAB_SOLONET_RPC_URL to the relays as
# MONAD_REGTEST_HTTP_RPC_URL (default http://host.docker.internal:48080). The mailbox and the
# forum need it, so a relay without it refuses to start. The relay checks the upstream's chain id
# and the checkpoint block before serving it. No WebSocket upstream.
[registry.evm_rpc]
enabled = true
capability_ttl_ms = 3600000
anonymous_units_per_hour = 1000000
# solonet keeps only about 6,950 blocks (about 75 minutes). Every 600 seconds (the default, set
# here so it is visible; 10 to 3600 allowed) each relay re-attests the monad-regtest checkpoint
# it advertises in GET /chains: it reads the block 16 below its upstream's head, checks every
# block back to the current checkpoint links by parent hash (the same chain), and only then
# advertises it. So the checkpoint never falls out of solonet's history while the relay runs.
# The checkpoint lab-init writes below is only where a relay starts: a relay restarted more than
# about an hour after lab-init needs `scripts/lab-cluster-app.sh refresh-checkpoint`.
operator_checkpoint_refresh_secs = 600

[[registry.evm_rpc.chains]]
id = "monad-regtest"
expected_chain_id = 20143
upstream_env = "MONAD_REGTEST_HTTP_RPC_URL"
checkpoint_block_number = @SOLONET_CHECKPOINT_NUMBER@
checkpoint_block_hash = "@SOLONET_CHECKPOINT_HASH@"
max_get_logs_range = 10

# Direct messages, shared by all three replicas through FoundationDB (HA step 6). Stamps are
# verified and broadcast through the solonet row above.
# The least a paid message carries, in wei: at or above the network's payment floor, which the
# relay enforces on every payment and refuses to start below (docs/protocol/chains/README.md,
# "Payment floor"). On Monad: 10 x 21000 gas x 100 gwei = 21000000000000000 wei = 0.021 MON.
[registry.evm_mailbox]
enabled = true
min_value_wei = "21000000000000000"

# The forum (`/topics`): every post and vote burns to this address on solonet. Its posts, votes
# and burn records are shared by all three replicas through FoundationDB (HA step 9), with frames
# over 64 KiB in the MinIO above.
[registry.forum]
burn_address = "0x000000000000000000000000000000000000dEaD"

[registry.pop]
enabled = false
evm_rpc_url = "http://unused.invalid"
hmac_secret = "unused-because-pop-is-disabled"
payment_recipient = "0x0000000000000000000000000000000000000000"
min_value_wei = "0"

# The price and energy feed from the relay's bundled history; the lab asks no provider.
[registry.oracle]
collect = false
