        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "max(frank_forum_stored_posts)",
          "refId": "A"
        }
      ],
      "title": "Stored canonical Forum posts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Newly stored direct messages over 5-minute windows; retries are excluded. History starts after this instrumentation is deployed.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
