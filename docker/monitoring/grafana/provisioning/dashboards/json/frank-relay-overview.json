          "refId": "A"
        }
      ],
      "title": "Relay scrape health",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Largest currently scraped relay-local public profile row count at each point in time. One series across deployments; overlapping relay counts are not added. Separate stores can differ, so this is not a global unique-profile count or signup count.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "max(frank_registry_stored_public_profile_records)",
          "legendFormat": "stored profiles (largest relay)",
          "refId": "A"
        }
      ],
      "title": "Stored public profile records (largest relay)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Rolling six-hour delta of the largest currently scraped relay-local profile count, aggregated before delta to join deployments. Earlier growth ages out of the window: a fall to zero does not mean profiles were deleted. Store differences, restoration, or target changes can also affect this estimate; it is not new signups.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "delta((max(frank_registry_stored_public_profile_records))[6h:1m])",
          "legendFormat": "6h net change (largest relay)",
          "refId": "A"
        }
      ],
      "title": "Stored public profile net change (rolling 6h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Current confirmed posts counted from the canonical Forum discovery index.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
