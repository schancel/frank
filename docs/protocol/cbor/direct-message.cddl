; Payload schemas for type 1 and its proof message-item frames.
; Imports common.cddl names conceptually; each implementation compiles a
; combined schema/module.

direct-message-delivery = {
  0: network-tag,
  1: account-ref, ; stamp key P' the sender used, key type 1 (README S9); directory binding is S10a.3
  2: framed-object, ; recipient-specific encrypted-payload frame
  3: digest-32, ; T3 digest of the exact field-2 frame
  4: [0*64 payment-member], ; a message may carry no payment (schema version 2 and later); when paying, two or more preferred, one permitted
  ? 5: account-ref, ; long-term recipient identity P (key type 1)
  ? 6: dleq-proof, ; Chaum-Pedersen DLEQ proof
  * uint => frank-value, ; additive fields retained only under README.md rules
}

payment-member = {
  0: uint .le 2147483647, ; stamp child index i (README T3a, S3)
  1: bstr .size (1..128), ; chain transaction identifier
  2: evm-quantity-256 / uint, ; verified value, fixed-width big-endian or uint satoshis
  3: bstr .size (1..128), ; derived destination/address bytes
  4: digest-32, ; exact T4 commitment verified in the transaction
  ? 5: uint .le 4294967295, ; UTXO output index (vout)
  ? 6: bstr .size (1..16384), ; optional explicit raw signed transaction bytes
}

stealth-metadata = {
  0: account-ref,                       ; ephemeral pubkey (key type 1 or 2)
  ? 1: uint .le 65535 / bstr .size (1..32), ; optional view tag
}

payment-transfer = {
  0: network-tag,                       ; e.g. "monad-testnet", "lotus", "bch"
  1: bstr .size (1..128),               ; txid / hash
  ? 2: uint .le 4294967295,             ; vout (UTXO output index)
  3: bstr .size (1..128),               ; destination address / pubkey
  4: evm-quantity-256 / uint,           ; value in satoshis uint or 32-byte big-endian
  ? 5: bstr .size (1..128),             ; optional token contract address or token ID
  ? 6: stealth-metadata,                ; optional stealth commitment { 0: ephemeral-pubkey, 1: view-tag }
  ? 7: digest-32,                       ; optional T4 commitment
  ? 8: bstr .size (1..16384),           ; optional raw signed transaction bytes
}

; 33-byte compressed SEC1 secp256k1 point; encoding rules are README T3b.
stamp-point = bstr .size 33

; c || s (README T3b).
dleq-proof = bstr .size 64

encrypted-message-content = {
  0: network-tag,
  1: uuid-16, ; stable logical message_id; encrypted in a real delivery
  2: framed-object, ; type-8 message-content-revision frame
  3: digest-32, ; T1a digest of field 2
  4: uuid-16, ; stable logical conversation_id (ticket #818)
  ? 5: conversation-name, ; short text; required on opening message; optional afterwards (ticket #818)
  ? 6: token-transfer, ; optional token transfer attached to message (tickets #1152, #1153)
  * uint => frank-value,
}

message-content = encrypted-message-content

token-transfer = {
  1: tstr, ; chain namespace (e.g. "monad", "ethereum", "solana")
  2: tstr, ; contract address
  3: #6.1001(biguint), ; amount in base units
  4: uint, ; decimals
  5: tstr, ; symbol
  ? 6: bstr, ; optional raw tx or permit bytes
  * uint => frank-value,
}

conversation-name = tstr .size (1..512)

; Type 5 schema 1 is retained for the permanently reserved proof fixture only.
recipient-encrypted-payload-v1 = {
  0: network-tag,
  1: account-ref, ; routing sender identity, not transferable authorship proof
  2: account-ref, ; routing recipient identity
  3: uint .le 65535, ; exact encryption-suite identifier
  4: bstr .size (1..64), ; suite-defined nonce
  5: bstr .size (1..524288), ; ciphertext of a complete type-6 frame
  6: stamp-point, ; E (README T3a)
  7: stamp-point, ; X (README T3a)
  8: dleq-proof, ; DLEQ proof (README T3b)
  * uint => frank-value,
}

; Type 5 schema 2, min_reader_version 2, is the production DM payload.
recipient-encrypted-payload-v2 = {
  0: network-tag,
  1: account-ref, ; routing sender identity, not transferable authorship proof
  2: account-ref, ; routing recipient identity
  3: 1, ; Frank-CBOR authenticated XChaCha20-Poly1305 suite
  4: bstr .size (1..524376), ; complete deterministic-CBOR crypto-box v2 envelope
  5: stamp-point, ; E (README T3a)
  6: stamp-point, ; X (README T3a)
  7: dleq-proof, ; DLEQ proof (README T3b)
  * uint => frank-value,
}

; Deterministic-CBOR bytes passed as crypto-box `context`; not a FRNK frame.
dm-crypto-context-v1 = {
  0: "frank/dm-crypto-context/v1",
  1: network-tag,
  2: account-ref, ; routing sender
  3: account-ref, ; routing recipient
  4: digest-32, ; exact opened sender directory-statement T1 hash
  5: digest-32, ; exact opened recipient directory-statement T1 hash
  6: account-ref, ; sender message-DH key M, key type 1
  7: account-ref, ; recipient message-DH key M, key type 1
  8: account-ref, ; recipient stamp key P', key type 1
  9: stamp-point, ; E
  10: stamp-point, ; X
  11: dleq-proof,
  12: 1, ; suite
  13: 5, ; object type
  14: 2, ; schema_version
  15: 2, ; min_reader_version
}

message-content-revision = {
  0: "frank", ; chain-independent logical-content transcript network domain
  1: [1*256 framed-object], ; ordered semantic message-item frames
  * uint => frank-value,
}

; A known container item's payload. Child values are independently framed so
; unknown child kinds and their exact bytes survive recursive forwarding.
container-message-item = {
  0: [1*256 framed-object],
  * uint => frank-value,
}

text-message-item = {
  0: tstr .size (0..262144),
  * uint => frank-value,
}

; Active type 19 / schema 1 / min-reader 1: stealth payment item.
stealth-message-item = {
  0: network-tag,
  1: account-ref, ; ephemeral pubkey (key type 1 or 2)
  2: [1*16 bstr .size (1..16384)], ; raw transaction payloads or hashes
  3: uint, ; transferred value
  ? 4: tstr .size (0..1024), ; optional memo
  * uint => frank-value,
}

; Active type 24 / schema 1 / min-reader 1: universal state channel update item.
channel-update-item = {
  0: digest-32,                      ; unique channel-id
  1: tstr .size (1..64),             ; app-id ("poker", "liars-dice", "swap", "raffle")
  2: uint .le 4294967295,            ; sequence-number (state turn / nonce)
  3: [1*8 chain-allocation],         ; allocations across 1 or more networks
  4: bstr .size (0..65536),          ; app-state (opaque or nested CBOR payload)
  5: [1*4 signature-entry],          ; participant signatures over state digest
  ? 6: bstr .size (1..128),          ; optional on-chain settlement contract or script reference
  * uint => frank-value,
}

chain-allocation = {
  0: network-tag,
  1: bstr .size (0..128),            ; empty for native currency, or token identifier
  2: [2*16 participant-balance],
}

participant-balance = {
  0: account-ref,                    ; participant public key
  1: evm-quantity-256 / uint,        ; allocated balance
}

; Modular application schemas nested within channel-update-item app-state (field 4)
dice-game-payload = {
  0: uint,                           ; round
  1: "commit" / "reveal" / "roll",   ; action
  2: digest-32,                      ; seed-commitment
  ? 3: bstr .size (1..64),           ; reveal-seed
  ? 4: uint .le 100,                 ; target-roll
  5: evm-quantity-256 / uint,        ; wager
  * uint => frank-value,
}

poker-game-payload = {
  0: digest-32,                      ; hand-id
  1: tstr .size (1..32),             ; phase
  2: tstr .size (1..32),             ; action
  ? 3: [1*10 digest-32],             ; card-commitments
  ? 4: [1*10 bstr .size (1..64)],    ; keys
  * uint => frank-value,
}

swap-offer-payload = {
  0: digest-32,                      ; swap-id
  1: bstr .size (0..128),            ; maker-asset
  2: evm-quantity-256 / uint,        ; maker-amount
  3: bstr .size (0..128),            ; taker-asset
  4: evm-quantity-256 / uint,        ; taker-amount
  5: uint .le 4294967295,            ; expiration
  ? 6: digest-32,                    ; htlc-hash
  * uint => frank-value,
}

raffle-payload = {
  0: digest-32,                      ; raffle-id
  1: evm-quantity-256 / uint,        ; ticket-price
  2: uint,                           ; tickets-sold
  ? 3: digest-32,                    ; winning-hash
  * uint => frank-value,
}

; Active type 25 / schema 1 / min-reader 1: relay forwarding delivery envelope.
forwarding-delivery-envelope = {
  0: network-tag,                       ; destination relay network, e.g. "monad-testnet"
  1: account-ref,                       ; destination relay routing identity (key type 1)
  2: framed-object,                     ; inner direct-message-delivery (Type 1) frame
  3: digest-32,                         ; forwarding payload digest of field 2
  4: [1*64 payment-member],             ; storage payment stamps compensating destination relay
  ? 5: tstr .size (1..256),             ; optional destination relay endpoint URI
  ? 6: uint .le 4294967295,             ; optional delivery TTL / expiration timestamp (seconds)
  * uint => frank-value,                ; additive extensible fields
}

; Active type 26 / schema 1 / min-reader 1: email bridge message item.
email-message-item = {
  0: tstr .size (1..256),               ; message_id (RFC 5322 Message-ID, e.g. "<...@domain>")
  1: email-party,                       ; from
  2: [1*64 email-party],                ; to (at least 1 recipient)
  ? 3: [*64 email-party],               ; cc (optional, up to 64 recipients)
  4: tstr .size (0..1024),              ; subject (UTF-8, e.g. "Re: ...")
  5: tstr .size (0..262144),            ; text_body (plain text representation)
  ? 6: tstr .size (0..524288),          ; html_body (optional HTML representation)
  ? 7: tstr .size (1..256),             ; in_reply_to (RFC 5322 In-Reply-To header)
  ? 8: [*64 tstr .size (1..256)],       ; references (RFC 5322 References header)
  ? 9: [*16 email-attachment],          ; attachments (optional metadata and bytes/CID)
  ? 10: email-party,                    ; reply_to (optional RFC 5322 Reply-To header)
  * uint => frank-value,                ; forward-compatible extensible fields
}

email-party = {
  0: tstr .size (3..320),               ; email address (e.g. "alice@example.com")
  ? 1: tstr .size (1..256),             ; display_name (e.g. "Alice Smith")
  ? 2: account-ref,                     ; frank_account (if mapped/known)
  * uint => frank-value,
}

email-attachment = {
  0: tstr .size (1..256),               ; filename
  1: tstr .size (1..128),               ; content_type (MIME type, e.g. "application/pdf")
  2: bstr .size (0..8388608),           ; content (raw bytes or hash/CID pointer)
  ? 3: tstr .size (1..128),             ; content_id (CID for inline images)
  * uint => frank-value,
}

; Active type 27 / schema 1 / min-reader 1: generic plugin message item. The container for an
; application item that has no dedicated frame. Field 1 is opaque to this profile: the plugin
; registered for the identifier in field 0 owns its encoding (deterministic CBOR, protobuf, ...).
plugin-message-item = {
  0: plugin-item-type,                  ; application item type identifier, e.g. "dice"
  1: bstr .size (0..524288),            ; the owning plugin's bytes, never interpreted here
  * uint => frank-value,                ; forward-compatible extensible fields
}

; Lowercase ASCII letters and digits in groups separated by single hyphens, 1..64 characters.
plugin-item-type = tstr .size (1..64) .regexp "[a-z0-9]+(-[a-z0-9]+)*"

