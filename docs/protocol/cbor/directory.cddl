; Type 2 wraps and signs the complete type-4 statement frame. This avoids a
; signature-containing-itself cycle while binding exact framing and versions.

directory-attestation = {
  0: framed-object, ; type-4 directory-statement frame
  1: [1*16 signature-entry],
  * uint => frank-value,
}

; Type 4, schema_version 2, min_reader_version 2: field 8 is required. An
; account whose only statement is schema 1 has no stamp key and cannot receive
; stamped direct messages (README S10a).
directory-statement = {
  0: network-tag,
  1: account-ref, ; directory subject: the currently registered key; changes only through one linked type-7 transition (README S10)
  2: uint .le 18446744073709551615, ; monotonic revision
  3: timestamp,
  4: [1*32 relay-binding],
  ? 5: [1*16 key-transition],
  ? 6: timestamp, ; expiry, if present
  ? 7: [1*8 account-ref], ; offline recovery authorities
  8: account-ref, ; stamp key P': key type 1, mandatory, no fallback (README S10a)
  ? 14: tstr .size (3..32), ; canonical username handle (lowercase ASCII alphanumeric)
  * uint => frank-value,
}

; Type 4, schema_version 1: the layout before the stamp key existed. It has no
; field 8 (C12: a field 8 in a schema 1 statement is a `schema` error, which
; CDDL cannot express beside the wildcard). Same fields 0 through 7 as above.
directory-statement-v1 = {
  0: network-tag,
  1: account-ref,
  2: uint .le 18446744073709551615,
  3: timestamp,
  4: [1*32 relay-binding],
  ? 5: [1*16 key-transition],
  ? 6: timestamp,
  ? 7: [1*8 account-ref],
  * uint => frank-value,
}

relay-binding = {
  0: bstr .size (16..64), ; relay_id, derived by its registered algorithm
  1: tstr .size (1..2048), ; exact opaque URI: README S4 characters and scheme; no codec normalization
  2: account-ref, ; relay signing/payment identity
  3: timestamp, ; binding expiry
  * uint => frank-value,
}

key-transition = {
  0: framed-object, ; type-7 key-transition-statement frame
  1: uint .le 65535, ; authorization/signature algorithm
  2: account-ref, ; signer; must equal statement prior_authority
  3: bstr .size (1..512), ; signature of the T2a transcript
  * uint => frank-value,
}

key-transition-statement = {
  0: network-tag,
  1: account-ref, ; directory subject
  2: account-ref, ; prior registered or offline recovery authority
  3: 1..18446744073709551615, ; revision
  4: account-ref, ; new key
  * uint => frank-value,
}

; Type 4, schema_version 3, min_reader_version 2: the registration profile of
; README section 11 (#106). V1 adds the optional field 9 without raising
; min_reader_version, because a schema-2 reader projects the statement through
; V6.3 and retains field 9. A schema-1 or schema-2 statement carrying field 9
; is a C12 `schema` error at its exact version, so neither older rule is
; extended in place; field 8 stays required (S10a.1).
directory-statement-v3 = {
  0: network-tag,
  1: account-ref, ; directory subject: the registrant's compressed public key
  2: uint .le 18446744073709551615, ; revision: the ms timestamp (M2)
  3: timestamp, ; the same ms timestamp split (M2)
  4: [1*32 relay-binding],
  ? 5: [1*16 key-transition],
  ? 6: timestamp, ; expiry = timestamp + ttl ms (M3)
  ? 7: [1*8 account-ref], ; offline recovery authorities
  8: account-ref, ; stamp key P': key type 1, mandatory, no fallback (S10a)
  ? 9: [1*64 profile-entry], ; the migrated profile entries (M4); absent when empty
  * uint => frank-value,
}

; One migrated AddressEntry. Authored array order is preserved (never resorted,
; like message-item order). Both maps are open for a later schema (C12).
profile-entry = {
  0: tstr, ; kind: the wallet's entry-type hint, consumer-interpreted
  1: [0*64 profile-header], ; the protobuf map<string, string>, C11-sorted
  2: bstr, ; body: exact bytes
  * uint => frank-value,
}

; One header of a profile entry. C1a forbids text map keys, so the protobuf
; name/value set is a list sorted bytewise by name with duplicates rejected
; (C11, S1a).
profile-header = {
  0: tstr, ; name
  1: tstr, ; value
  * uint => frank-value,
}

; Provisional preview allocation (#742 accepting reviewed #719 C1–C14).
; Type 4 schema 4 / min_reader 4; separate from schemas 1–3 above.
; Exact schema 4 rejects undeclared fields (C12); future compatible schemas
; retain optional bytes under V6.3. Fields 5, 7 and 9 remain unsupported.
; README "Provisional directory preview" owns semantics and admission boundary.
directory-statement-v4 = {
  0: network-tag,
  1: directory-preview-key, ; subject/directory authority P
  2: uint .le 18446744073709551615, ; revision, zero at bootstrap
  3: timestamp,
  4: [directory-preview-relay],
  6: timestamp, ; mandatory expiry, positive validity <= 3600 seconds
  8: directory-preview-key, ; stamp P'
  10: directory-preview-key, ; distinct message-DH M, never profile field 9
  11: uint .le 18446744073709551615, ; mailbox_key_generation
  12: uint .le 18446744073709551615, ; stamp_key_generation
  13: null / bstr .size 32, ; exact predecessor type-4 T1; null at rev0
  ? 14: tstr .size (3..32), ; canonical username handle (lowercase ASCII alphanumeric)
  * uint => frank-value,
}

directory-preview-key = { 0: 1, 1: bstr .size 33 }
directory-preview-relay = {
  0: bstr .size (16..64),
  1: tstr .size (1..2048), ; S4 plus HTTPS only; exact bytes, no normalization
  2: directory-preview-key,
  3: timestamp, ; covers statement expiry
  * uint => frank-value,
}
; The existing type-2 schema1/min1 envelope is unchanged. For a v4 child it
; contains exactly one algorithm-1 strict-DER low-S signature by field 1.
; Complete bare v4 and enclosing type-2 frames each have a 262144-byte limit.
