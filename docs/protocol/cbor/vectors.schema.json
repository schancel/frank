{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frank:spec:cbor:v1:vectors",
  "title": "Frank deterministic-CBOR v1 vector manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "cases"],
  "properties": {
    "format": { "const": "frank-cbor-v1-vectors" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "frame_hex",
        "validation_context",
        "expectation",
        "rules"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "description": { "type": "string", "maxLength": 2048 },
        "source": { "enum": ["typescript", "rust", "handcrafted"] },
        "frame_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "maxLength": 16777234
        },
        "validation_context": { "$ref": "#/$defs/validation-context" },
        "expectation": { "enum": ["accept", "reject"] },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][0-9]+[a-z]?$" }
        },
        "type_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "content_hash_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content_digest_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "payload_digest_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "payment_commitments_hex": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "error_category": {
          "enum": [
            "frame",
            "unsupported",
            "resource",
            "malformed",
            "noncanonical",
            "schema",
            "semantic",
            "cryptographic"
          ]
        },
        "paired_case": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "expectation": { "const": "accept" } } },
          "then": {
            "required": ["type_id", "schema_version", "content_hash_hex"],
            "not": { "required": ["error_category"] }
          }
        },
        {
          "if": { "properties": { "expectation": { "const": "reject" } } },
          "then": { "required": ["error_category"] }
        },
        {
          "if": {
            "properties": {
              "expectation": { "const": "accept" },
              "type_id": { "const": 1 }
            },
            "required": ["type_id"]
          },
          "then": {
            "required": [
              "content_digest_hex",
              "payload_digest_hex",
              "payment_commitments_hex"
            ],
            "properties": {
              "validation_context": {
                "required": ["payment_policy", "decrypted_frame_hex"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectation": { "const": "accept" },
              "type_id": { "const": 2 }
            },
            "required": ["type_id"]
          },
          "then": {
            "properties": {
              "validation_context": {
                "required": ["prior_directory_statement_frame_hex"]
              }
            }
          }
        }
      ]
    },
    "validation-context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "reader_version",
        "supported_schemas",
        "opaque_retention_allowed"
      ],
      "properties": {
        "operation": { "enum": ["frame", "generic", "typed", "full"] },
        "reader_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "supported_schemas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type_id", "schema_version"],
            "properties": {
              "type_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            }
          }
        },
        "opaque_retention_allowed": { "type": "boolean" },
        "decrypted_frame_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "maxLength": 16777234
        },
        "payment_policy": { "$ref": "#/$defs/payment-policy" },
        "prior_directory_statement_frame_hex": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$",
              "maxLength": 16777234
            }
          ]
        }
      }
    },
    "payment-policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_value_hex", "observations"],
      "properties": {
        "minimum_value_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/payment-observation" }
        }
      }
    },
    "payment-observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id_hex",
        "destination_hex",
        "value_hex",
        "commitment_hex"
      ],
      "properties": {
        "transaction_id_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){1,128}$"
        },
        "destination_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){1,128}$"
        },
        "value_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "commitment_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
