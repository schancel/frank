{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frank:spec:cbor:v1:vectors",
  "title": "Frank deterministic-CBOR v1 vector manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "cases"],
  "properties": {
    "format": {
      "const": "frank-cbor-v1-vectors"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "frame_hex",
        "validation_context",
        "expectation",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "source": {
          "enum": ["typescript", "rust", "handcrafted"]
        },
        "frame_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "maxLength": 16777236
        },
        "validation_context": {
          "$ref": "#/$defs/validation-context"
        },
        "expectation": {
          "enum": ["accept", "reject", "retain"]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][0-9]+[a-z]?(\\.[0-9]+)?$"
          }
        },
        "type_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "content_hash_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retained_frame_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "maxLength": 16777236
        },
        "content_digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload_digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payment_commitments_hex": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "error_category": {
          "enum": [
            "frame",
            "unsupported",
            "resource",
            "malformed",
            "noncanonical",
            "schema",
            "semantic",
            "cryptographic"
          ]
        },
        "error_stage": {
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8.1",
            "8.2",
            "8.3",
            "8.4",
            "9",
            "10.1",
            "10.2",
            "10.3",
            "10.4",
            "10.5",
            "10.6"
          ]
        },
        "paired_case": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "pair_relation": {
          "enum": [
            "one_byte_mutation",
            "insertion_order_equivalent",
            "cross_language_roundtrip",
            "opaque_retention"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "reject"
              },
              "validation_context": {
                "properties": {
                  "operation": {
                    "const": "frame"
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["expectation", "validation_context"]
          },
          "then": {
            "properties": {
              "error_category": {
                "enum": ["frame", "unsupported", "resource"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "reject"
              },
              "validation_context": {
                "properties": {
                  "operation": {
                    "const": "generic"
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["expectation", "validation_context"]
          },
          "then": {
            "properties": {
              "error_category": {
                "enum": [
                  "frame",
                  "unsupported",
                  "resource",
                  "malformed",
                  "noncanonical",
                  "schema"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "reject"
              },
              "validation_context": {
                "properties": {
                  "operation": {
                    "const": "typed"
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["expectation", "validation_context"]
          },
          "then": {
            "properties": {
              "error_category": {
                "enum": [
                  "frame",
                  "unsupported",
                  "resource",
                  "malformed",
                  "noncanonical",
                  "schema",
                  "semantic"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "validation_context": {
                "properties": {
                  "operation": {
                    "enum": ["typed", "full"]
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["validation_context"]
          },
          "then": {
            "properties": {
              "validation_context": {
                "required": ["prior_directory_statement_frame_hex"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "retain"
              }
            },
            "required": ["expectation"]
          },
          "then": {
            "properties": {
              "validation_context": {
                "properties": {
                  "opaque_retention_allowed": {
                    "const": true
                  }
                },
                "required": ["opaque_retention_allowed"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "accept"
              },
              "validation_context": {
                "properties": {
                  "operation": {
                    "enum": ["typed", "full"]
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["expectation", "validation_context"]
          },
          "then": {
            "required": ["type_id", "schema_version", "content_hash_hex"],
            "properties": {
              "error_category": false,
              "error_stage": false,
              "retained_frame_hex": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "accept"
              }
            },
            "required": ["expectation"]
          },
          "then": {
            "properties": {
              "error_category": false,
              "error_stage": false,
              "retained_frame_hex": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "reject"
              }
            },
            "required": ["expectation"]
          },
          "then": {
            "required": ["error_category"],
            "properties": {
              "retained_frame_hex": false,
              "content_hash_hex": false,
              "content_digest_hex": false,
              "payload_digest_hex": false,
              "payment_commitments_hex": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "retain"
              }
            },
            "required": ["expectation"]
          },
          "then": {
            "required": ["retained_frame_hex"],
            "properties": {
              "error_category": false,
              "error_stage": false,
              "content_hash_hex": false,
              "content_digest_hex": false,
              "payload_digest_hex": false,
              "payment_commitments_hex": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "accept"
              },
              "type_id": {
                "const": 1
              },
              "validation_context": {
                "properties": {
                  "operation": {
                    "const": "full"
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["expectation", "type_id", "validation_context"]
          },
          "then": {
            "required": [
              "content_digest_hex",
              "payload_digest_hex",
              "payment_commitments_hex"
            ],
            "properties": {
              "validation_context": {
                "type": "object",
                "required": ["payment_policy", "decrypted_frame_hex"],
                "properties": {
                  "payment_policy": {
                    "type": "object"
                  },
                  "decrypted_frame_hex": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type_id": {
                "const": 1
              },
              "validation_context": {
                "properties": {
                  "operation": {
                    "const": "full"
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["type_id", "validation_context"]
          },
          "then": {
            "properties": {
              "validation_context": {
                "type": "object",
                "required": ["payment_policy", "decrypted_frame_hex"],
                "properties": {
                  "payment_policy": {
                    "type": "object"
                  },
                  "decrypted_frame_hex": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["paired_case"]
          },
          "then": {
            "required": ["pair_relation"]
          }
        },
        {
          "if": {
            "required": ["pair_relation"]
          },
          "then": {
            "required": ["paired_case"]
          }
        },
        {
          "if": {
            "properties": {
              "validation_context": {
                "properties": {
                  "operation": {
                    "const": "full"
                  }
                },
                "required": ["operation"]
              }
            },
            "required": ["validation_context"]
          },
          "then": {
            "properties": {
              "validation_context": {
                "required": ["payment_policy", "decrypted_frame_hex"]
              }
            }
          }
        }
      ]
    },
    "validation-context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "route_byte_limit",
        "reader_version",
        "supported_schemas",
        "opaque_retention_allowed"
      ],
      "properties": {
        "operation": {
          "enum": ["frame", "generic", "typed", "full"]
        },
        "reader_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "supported_schemas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type_id", "schema_version"],
            "properties": {
              "type_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "schema_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            }
          }
        },
        "opaque_retention_allowed": {
          "type": "boolean"
        },
        "decrypted_frame_hex": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$",
              "maxLength": 16777236
            }
          ]
        },
        "payment_policy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/payment-policy"
            }
          ]
        },
        "prior_directory_statement_frame_hex": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$",
              "maxLength": 16777236
            }
          ]
        },
        "route_byte_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388617
        }
      }
    },
    "payment-policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_value_hex", "observations"],
      "properties": {
        "minimum_value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/payment-observation"
          }
        }
      }
    },
    "payment-observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id_hex",
        "destination_hex",
        "value_hex",
        "commitment_hex"
      ],
      "properties": {
        "transaction_id_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){1,128}$"
        },
        "destination_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){1,128}$"
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "commitment_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
