{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frank:spec:cbor:v1:vectors",
  "title": "Frank deterministic-CBOR v1 vector manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "cases"],
  "properties": {
    "format": { "const": "frank-cbor-v1-vectors" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "frame_hex", "expectation", "rules"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "description": { "type": "string", "maxLength": 2048 },
        "source": { "enum": ["typescript", "rust", "handcrafted"] },
        "frame_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "maxLength": 16777234
        },
        "expectation": { "enum": ["accept", "reject"] },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][0-9]+$" }
        },
        "type_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "content_hash_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "error_category": {
          "enum": [
            "frame",
            "unsupported",
            "resource",
            "malformed",
            "noncanonical",
            "schema",
            "semantic",
            "cryptographic"
          ]
        },
        "paired_case": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "expectation": { "const": "accept" } } },
          "then": {
            "required": ["type_id", "schema_version", "content_hash_hex"],
            "not": { "required": ["error_category"] }
          }
        },
        {
          "if": { "properties": { "expectation": { "const": "reject" } } },
          "then": { "required": ["error_category"] }
        }
      ]
    }
  }
}
