{
  "name": "frank-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Root workspace for Frank: app/ (Quasar/Vue frontend) and packages/* (standalone, Vue/Pinia-free cashweb protocol + Monad wallet client libraries). See PLAN.md's \"monorepo subproject split\" section and ticket #53.",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "resolutions": {
    "@vue/compiler-sfc": "3.5.43",
    "@vue/compiler-core": "3.5.43"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "scripts": {
    "demo": "TSX_TSCONFIG_PATH=packages/bot/tsconfig.json node --import tsx packages/bot/demo/demo.ts",
    "demo:smoke": "TSX_TSCONFIG_PATH=packages/bot/tsconfig.json node --import tsx packages/bot/demo/smoke.ts",
    "build:contracts": "yarn --cwd packages/contracts build",
    "test:contracts": "yarn --cwd packages/contracts test",
    "deploy:contracts": "yarn --cwd packages/contracts deploy"
  }
}
