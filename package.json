{
  "name": "frank-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Root workspace for Frank: app/ (Quasar/Vue frontend) and packages/* (standalone, Vue/Pinia-free cashweb protocol + Monad wallet client libraries). See PLAN.md's \"monorepo subproject split\" section and ticket #53.",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "resolutions": {
    "@vue/compiler-sfc": "3.5.43",
    "@vue/compiler-core": "3.5.43",
    "builder-util-runtime": "9.2.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "scripts": {
    "demo": "TSX_TSCONFIG_PATH=packages/bot/tsconfig.json node --import tsx packages/bot/demo/demo.ts",
    "demo:smoke": "TSX_TSCONFIG_PATH=packages/bot/tsconfig.json node --import tsx packages/bot/demo/smoke.ts",
    "demo:sweep": "TSX_TSCONFIG_PATH=packages/bot/tsconfig.json node --import tsx packages/bot/demo/funds.ts sweep --demo --abandoned",
    "typecheck": "node --import tsx scripts/typecheck.ts",
    "typecheck:fast": "node --import tsx scripts/typecheck.ts --fast",
    "typecheck:tsc": "node --import tsx scripts/typecheck.ts --tsc",
    "message-types:generate": "python3 docs/protocol/message-types/generate.py",
    "message-types:check": "python3 docs/protocol/message-types/generate.py --check",
    "vectors:generate": "node --import tsx packages/frank-codec/scripts/vectors.mts",
    "vectors:check": "node --import tsx packages/frank-codec/scripts/vectors.mts --check",
    "build": "yarn --cwd app build",
    "build:pwa": "yarn --cwd app build:pwa",
    "build:spa": "yarn --cwd app build:spa",
    "build:electron": "yarn --cwd app build:electron",
    "build:extensions": "yarn --cwd app build:extensions",
    "build:ext:chrome": "yarn --cwd app build:ext:chrome",
    "build:ext:firefox": "yarn --cwd app build:ext:firefox",
    "build:ext:safari": "yarn --cwd app build:ext:safari",
    "build:ext:safari:app": "yarn --cwd app build:ext:safari:app",
    "build:contracts": "yarn --cwd packages/contracts build",
    "test:contracts": "yarn --cwd packages/contracts test",
    "deploy:contracts": "yarn --cwd packages/contracts deploy",
    "test:two-wallets": "TSX_TSCONFIG_PATH=packages/bot/tsconfig.json node --import tsx packages/bot/demo/two-wallets.ts",
    "test:unit": "yarn --cwd packages/wallet test:unit && yarn --cwd app test:unit:ci",
    "test:integration": "yarn --cwd packages/wallet test:integration && yarn --cwd app test:integration",
    "test:browser": "yarn --cwd app test:browser",
    "bench:wallet": "yarn --cwd packages/wallet bench",
    "docs:dev": "yarn workspace @frank/docs dev",
    "docs:build": "yarn workspace @frank/docs build",
    "docs:preview": "yarn workspace @frank/docs preview",
    "docs:dist": "DOCS_BASE=/docs/ yarn docs:build"
  },
  "devDependencies": {
    "@types/bluebird": "^3.5.42",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  }
}
