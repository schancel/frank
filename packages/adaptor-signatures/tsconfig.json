{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2020",
    "lib": ["es2020"],
    // See @frank/cashweb's tsconfig.json for why this is needed (avoids auto-including broken
    // hoisted @types stubs from unrelated devDependencies elsewhere in the workspace).
    "types": ["node", "jest"]
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "**/*.jest.spec.ts", "**/*.jest.test.ts"]
}
