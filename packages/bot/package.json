{
  "name": "@frank/bot",
  "version": "0.0.1",
  "description": "Headless Qwen-backed Frank bot (ticket #9): a cryptographic on-chain identity that pays real MON stamp payments to speak, over @frank/wallet + @frank/cashweb -- no Vue/Pinia, no app/ dependency. See README.md for the full runbook.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "bot": "tsx qwen-bot.livecheck.ts",
    "blackjack": "tsx blackjack-bot.livecheck.ts",
    "target:blackjack": "tsx targets/blackjack.ts",
    "target:raffle": "tsx targets/raffle.ts",
    "target:vendor": "tsx targets/vendor.ts",
    "target:qwen": "tsx targets/qwen.ts",
    "target:faucet": "tsx targets/faucet.ts",
    "target:lobby": "tsx targets/lobby.ts",
    "target:rps": "tsx targets/rps.ts",
    "target:dice": "tsx targets/dice.ts",
    "target:all": "tsx targets/all-bots.ts",
    "raffle": "tsx raffle-bot.livecheck.ts",
    "vendor": "tsx vendor-bot.livecheck.ts",
    "faucet": "tsx faucet-bot.livecheck.ts",
    "curated-defaults": "tsx print-curated-defaults.ts",
    "demo": "node --import tsx demo/demo.ts",
    "demo:smoke": "node --import tsx demo/smoke.ts",
    "funds:report": "node --import tsx demo/funds.ts report",
    "funds:sweep": "node --import tsx demo/funds.ts sweep",
    "regtest:fetch": "node --import tsx demo/regtest/bitcoin-abc.ts",
    "regtest:check": "node --import tsx demo/regtest/regtest-stack.livecheck.ts",
    "regtest:ecash-send": "node --import tsx demo/regtest/ecash-send.livecheck.ts",
    "regtest:monad-check": "node --import tsx demo/regtest/monad-check.livecheck.ts",
    "regtest:monad-reserve": "node --import tsx demo/regtest/monad-reserve.livecheck.ts",
    "regtest:monad-parallel-send": "PSEND_STACK_MODULE=demo/regtest/monad-parallel-send-stack.ts PHASES=${PHASES:-a,d,e,h,r,w,m,n,b} FUNDED=${FUNDED:-10} BUDGET_WEI=1000000000000000000000 node --import tsx parallel-send.livecheck.ts",
    "regtest:monad-status": "node --import tsx demo/regtest/monad-regtest.ts status",
    "regtest:monad-start": "node --import tsx demo/regtest/monad-regtest.ts start",
    "regtest:monad-stop": "node --import tsx demo/regtest/monad-regtest.ts stop",
    "demo:directory-browser": "node demo/directory-trust/check-admission-browser.cjs",
    "test": "jest"
  },
  "dependencies": {
    "@frank/bot-framework": "*",
    "@frank/codec": "*",
    "@frank/directory-admission": "*",
    "@frank/cashweb": "*",
    "@frank/wallet": "*",
    "axios": "^0.24.0",
    "bip39": "^3.0.2",
    "ethers": "^6.17.0",
    "level": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "~0.28.0",
    "@types/jest": "^29",
    "@types/node": "^16.11.11",
    "jest": "^29",
    "ts-jest": "^29",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
