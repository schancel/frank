{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@frank/bot-framework": ["../bot-framework/src/index.ts"],
      "@frank/bot-framework/*": ["../bot-framework/src/*"],
      "@frank/cashweb/*": ["../cashweb/*"],
      "@frank/codec": ["../frank-codec/src/index.ts"],
      "@frank/directory-admission": ["../directory-admission/src/index.ts"],
      "@frank/directory-admission/browser": [
        "../directory-admission/src/browser.ts"
      ],
      "@frank/directory-admission/node": ["../directory-admission/src/node.ts"],
      "@frank/crypto-box": ["../crypto-box/src/index.ts"],
      "@frank/nakamoto": ["../nakamoto/src/index.ts"],
      "@frank/nakamoto/*": ["../nakamoto/src/*"],
      "@frank/wallet/*": ["../wallet/*"]
    },
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2022",
    "lib": ["es2022", "DOM"],
    "types": ["node", "jest"]
  },
  "include": [
    "**/*",
    "../bitcore-lib-xpi/types.d.ts",
    "../wallet/level.d.ts",
    "../wallet/ecash-wallet-sdk.d.ts"
  ],
  "exclude": ["node_modules", "**/*.jest.spec.ts", "**/*.jest.test.ts"]
}
