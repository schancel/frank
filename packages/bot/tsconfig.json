{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@frank/cashweb/*": ["../cashweb/*"],
      "@frank/wallet/*": ["../wallet/*"]
    },
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2020",
    "lib": ["es2020"],
    "types": ["node"]
  },
  "include": ["**/*", "../bitcore-lib-xpi/types.d.ts"],
  "exclude": ["node_modules", "**/*.jest.spec.ts", "**/*.jest.test.ts"]
}
