{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2020",
    "lib": ["es2020"],
    // Without this, TS auto-includes every `@types/*` package found anywhere in the (hoisted,
    // monorepo-wide) node_modules tree as an ambient global -- including broken stub packages
    // pulled in transitively by unrelated devDependencies elsewhere in the workspace (e.g.
    // `@types/minimatch`, a stub with no real .d.ts entry, via electron-builder's own chain).
    // Scoping to just what this package actually needs avoids that.
    "types": ["node", "jest"]
  },
  "include": [
    "**/*",
    // `bitcore-lib-xpi` ships no types of its own -- this repo's hand-written ambient
    // declaration (`declare module 'bitcore-lib-xpi' {...}`) lives alongside the package itself
    // (`packages/bitcore-lib-xpi/types.d.ts`) so every consumer picks it up the same way.
    "../bitcore-lib-xpi/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.jest.spec.ts",
    "**/*.jest.test.ts",
    "**/*.livecheck.ts"
  ]
}
