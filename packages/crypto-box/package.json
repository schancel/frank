{
  "name": "@frank/crypto-box",
  "version": "0.0.1",
  "description": "Versioned deniable encryption suites. Suite 65535 is reserved for proof vectors and is never produced.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.jest.json",
    "lint": "eslint . --ext .ts,.js,.cjs,.mjs",
    "format": "prettier --config ../../app/.prettierrc.json --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" package.json tsconfig.json tsconfig.jest.json jest.config.cjs .eslintrc.cjs runtime-deps.json bundle-entries.json README.md",
    "check:shared": "node scripts/check-shared.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:bundle": "node scripts/bundle-report.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "^16.11.11",
    "esbuild": "~0.28.0",
    "jest": "^29",
    "ts-jest": "^29",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@frank/nakamoto": "0.0.1",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0"
  }
}
