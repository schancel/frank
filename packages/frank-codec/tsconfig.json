{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2020",
    // No DOM and no Node globals in src/: the codec must stay browser-safe without polyfills.
    "lib": ["es2020"],
    "types": []
  },
  "include": ["src/**/*"]
}
