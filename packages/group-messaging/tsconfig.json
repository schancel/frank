{
  "extends": "../cashweb/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@frank/cashweb/*": [
        "../cashweb/*"
      ],
      "@frank/codec": [
        "../frank-codec/src/index.ts"
      ],
      "@frank/nakamoto": [
        "../nakamoto/src/index.ts"
      ],
      "@frank/nakamoto/*": [
        "../nakamoto/src/*"
      ],
      "@frank/crypto-box": [
        "../crypto-box/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../bitcore-lib-xpi/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.jest.test.ts"
  ]
}
