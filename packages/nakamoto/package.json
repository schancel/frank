{
  "name": "@frank/nakamoto",
  "version": "0.0.1",
  "description": "Typed chain library for BTC, BCH, XEC, and XPI. Consensus bytes follow the chains. The public API does not follow bitcore-lib.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./btc": {
      "types": "./dist/btc.d.ts",
      "import": "./dist/btc.js"
    },
    "./bch": {
      "types": "./dist/bch.d.ts",
      "import": "./dist/bch.js"
    },
    "./xec": {
      "types": "./dist/xec.d.ts",
      "import": "./dist/xec.js"
    },
    "./xpi": {
      "types": "./dist/xpi.d.ts",
      "import": "./dist/xpi.js"
    },
    "./integer": {
      "types": "./dist/integer.d.ts",
      "import": "./dist/integer.js"
    },
    "./script-num": {
      "types": "./dist/script-num.d.ts",
      "import": "./dist/script-num.js"
    }
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.jest.json",
    "lint": "eslint . --ext .ts,.js,.cjs,.mjs",
    "format": "prettier --config ../../app/.prettierrc.json --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" package.json tsconfig.json tsconfig.jest.json jest.config.cjs .eslintrc.cjs runtime-deps.json bundle-entries.json ATTRIBUTION.md",
    "check:shared": "node scripts/check-shared.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:bundle": "node scripts/bundle-report.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "^16.11.11",
    "bitcore-lib-xpi": "*",
    "esbuild": "~0.28.0",
    "jest": "^29",
    "ts-jest": "^29",
    "typescript": "^5.9.3"
  }
}
