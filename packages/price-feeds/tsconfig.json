{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2022",
    "lib": ["es2022", "DOM"],
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "test/**/*"]
}
