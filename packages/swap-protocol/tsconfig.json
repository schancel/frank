{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2020",
    "lib": ["es2020"],
    "types": []
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "**/*.jest.spec.ts", "**/*.jest.test.ts"]
}
