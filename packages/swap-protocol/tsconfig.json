{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2020",
    "lib": ["es2020"],
    "types": []
  },
  "include": ["**/*"],
  "exclude": [
    "node_modules",
    "**/*.jest.spec.ts",
    "**/*.jest.test.ts",
    "src/storage/negotiation-browser.ts",
    "src/storage/negotiation-native.ts",
    "src/storage/negotiation-native-level.d.ts",
    "src/storage/*-suite.ts",
    "src/storage/*.testutil.ts",
    "src/storage/*.mjs"
  ]
}
