{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2022",
    "lib": ["es2022", "DOM"],
    // See @frank/cashweb's tsconfig.json for why this is needed (avoids auto-including broken
    // hoisted @types stubs from unrelated devDependencies elsewhere in the workspace).
    "types": ["node", "jest"],
    "paths": {
      "@frank/codec": ["../frank-codec/src/index.ts"],
      "@frank/price-feeds": ["../price-feeds/src/index.ts"],
      "@frank/cashweb/*": ["../cashweb/*"],
      "@frank/wallet/*": ["./*"]
    }
  },
  "include": [
    "**/*",
    // See @frank/cashweb's tsconfig.json for why this is needed.
    "../bitcore-lib-xpi/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.jest.spec.ts",
    "**/*.jest.test.ts",
    "**/*.livecheck.ts",
    "**/*.smoketest.ts",
    "**/*.smoke.ts"
  ]
}
