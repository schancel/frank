{
  // For `node --import tsx` scripts (*.livecheck.ts) that load @frank/nakamoto or
  // @frank/crypto-box (directly, or through @frank/cashweb): their package exports are
  // import-only, so point at their source the way jest.config.js does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@frank/group-messaging/*": ["../group-messaging/*"],
      "@frank/codec": ["../frank-codec/src/index.ts"],
      "@frank/price-feeds": ["../price-feeds/src/index.ts"],
      "@frank/cashweb/*": ["../cashweb/*"],
      "@frank/wallet/*": ["./*"],
      "@frank/nakamoto": ["../nakamoto/src/index.ts"],
      "@frank/nakamoto/*": ["../nakamoto/src/*"],
      "@frank/crypto-box": ["../crypto-box/src/index.ts"]
    }
  }
}
